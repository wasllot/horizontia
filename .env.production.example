# Plantilla de producción de Horizontia: cópiala como .env en el servidor y completa lo marcado con «CAMBIAR».
# Verifica el resultado con:  php artisan academy:preflight   (o Admin → Estado del sistema)

APP_NAME=Horizontia
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate
APP_URL=https://CAMBIAR-tudominio.com
ACADEMY_PRIVATE_MODE=true
ACADEMY_TIMEZONE=America/Mexico_City

# Datos legales (salen en los avisos; que un asesor legal revise los textos)
ACADEMY_LEGAL_NAME="CAMBIAR razón social"
ACADEMY_CONTACT_EMAIL=contacto@CAMBIAR-tudominio.com
ACADEMY_ADDRESS="CAMBIAR dirección fiscal"
ACADEMY_REFUND_DAYS=7

# Sesión y cookies (solo HTTPS)
SESSION_DRIVER=file
SESSION_SECURE_COOKIE=true
SESSION_LIFETIME=120

# Base de datos, caché y colas
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horizontia
DB_USERNAME=CAMBIAR
DB_PASSWORD=CAMBIAR
# En Plesk/hosting compartido SIN Redis ni worker: caché/sesión en archivos, cola en base de datos y el cron la procesa cada minuto.
CACHE_STORE=file
QUEUE_CONNECTION=database
ACADEMY_QUEUE_VIA_SCHEDULER=true
# Con Redis y un worker propio (VPS): CACHE_STORE=redis, QUEUE_CONNECTION=redis, ACADEMY_QUEUE_VIA_SCHEDULER=false y REDIS_HOST=127.0.0.1

# Correo transaccional real (Resend, Postmark, SES, Brevo…). Publica SPF, DKIM y DMARC de tu dominio.
MAIL_MAILER=smtp
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-responder@CAMBIAR-tudominio.com
MAIL_FROM_NAME="${APP_NAME}"

# Archivos: públicos (portadas) y privados (videos de pago, documentos). Ver docs/r2-storage.md
FILESYSTEM_DISK=r2
PRIVATE_FILESYSTEM_DISK=r2_private

# Avisos y respaldos
ACADEMY_ALERT_EMAIL=tu-correo@CAMBIAR.com    # recibe un correo (máx. 1/hora por error) cuando algo falla
ACADEMY_BACKUP_KEEP_DAYS=14
BACKUP_DISK=r2_private                      # copia de cada respaldo fuera del servidor ('' = solo local)

# Scripts de mantenimiento de public/: déjalos sin token (cerrados) o bórralos
# Administrador inicial de una instalación limpia (tareas.php → «Instalación limpia»). Sin contraseña se genera una y se muestra una sola vez.
ACADEMY_ADMIN_EMAIL=admin@CAMBIAR-tudominio.com
ACADEMY_ADMIN_PASSWORD=

# Para el panel sin SSH (public/tareas.php): una clave larga y secreta (24+ caracteres). Déjala vacía y borra el archivo cuando termines.
DEPLOY_TOKEN=
