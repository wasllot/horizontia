APP_NAME=Horizontia
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=horizontia
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=Horizontia-

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
# Token para los scripts de mantenimiento en public/ (min. 24 caracteres; vacio = deshabilitados)
DEPLOY_TOKEN=

# --- Cloudflare R2 (ver docs/r2-storage.md) ---
# FILESYSTEM_DISK=r2                 # imagenes publicas (miniaturas, avatares, blog)
# PRIVATE_FILESYSTEM_DISK=r2_private # videos de pago, SCORM, tareas (sin URL publica)
# LIVEWIRE_TMP_DISK=r2_private       # subida directa navegador -> R2 (requiere CORS)
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=horizontia-public
# R2_PUBLIC_URL=https://media.tudominio.com
# R2_PRIVATE_BUCKET=horizontia-private

# --- Academia privada y paginas legales (config/academy.php) ---
ACADEMY_PRIVATE_MODE=true
# ACADEMY_LEGAL_NAME="Tu Razon Social S.A. de C.V."
# ACADEMY_CONTACT_EMAIL=contacto@tudominio.com
# ACADEMY_ADDRESS="Calle, numero, colonia, CP, ciudad"
# ACADEMY_REFUND_DAYS=7
# Zona horaria de las fechas de cursos presenciales (hora de la sede)
# ACADEMY_TIMEZONE=America/Mexico_City

# Producción (ver docs/produccion.md y .env.production.example)
SESSION_SECURE_COOKIE=false
ACADEMY_ALERT_EMAIL=
ACADEMY_BACKUP_KEEP_DAYS=14
BACKUP_DISK=

# --- Funciones de la academia (todas activas por defecto; pon false para apagar una) ---
# ACADEMY_CERTIFICATES=true
# ACADEMY_COMMUNITY=true
# ACADEMY_PWA=true
# ACADEMY_CHAT=true
# ACADEMY_ACCESS_REQUESTS=true
# ACADEMY_PROGRESS_REMINDERS=true
# ACADEMY_STUDIO_DAILY_LIMIT=40
# ACADEMY_WHATSAPP_COUNTRY_CODE=52
# Secreto del webhook de Zoom para publicar solas las grabaciones en la nube (ver docs/funciones.md)
# ZOOM_WEBHOOK_SECRET=
